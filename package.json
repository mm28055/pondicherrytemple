{
  "name": "sthalam",
  "version": "0.1.0",
  "private": true,
  "description": "Sthalam — the Temple Documentation Project website",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-db.mjs next dev",
    "build": "node scripts/with-db.mjs next build",
    "vercel-build": "payload migrate && next build",
    "start": "node scripts/with-db.mjs next start",
    "typecheck": "tsc --noEmit",
    "payload": "node scripts/with-db.mjs payload",
    "seed": "node scripts/with-db.mjs payload seed",
