# Copy this file to .env and fill it in. Never commit .env.

# Signs admin logins. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# THE DATABASE — one of these two.
#
# Neon, the real data (the live site and anyone editing it). The "pooled"
# connection string from the Neon dashboard:
# DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Or a practice copy on this laptop — an embedded Postgres (PGlite) that
# `npm run dev` starts by itself; nothing to install. Fill it with the
# starter content once with `npm run seed`.
PGLITE_DIR=./.data/pgdata
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# PHOTOS AND VIDEOS — Cloudflare R2, when these are filled in. Left empty,
# uploads are kept on this laptop in MEDIA_DIR instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address, e.g. https://pub-xxxx.r2.dev (later https://media.sthalam.org)
R2_PUBLIC_URL=
MEDIA_DIR=./.data/media
